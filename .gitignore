# Dépendances (se réinstallent avec `npm ci`)
node_modules/

# Résultats de build et rapports de tests : générés, jamais versionnés
dist/
reports/
coverage/

# Secrets et configuration locale : JAMAIS dans Git (on versionne seulement .env.example)
.env
.env.*
!.env.example

# Fichiers d'éditeur / système
.DS_Store
.idea/
.vscode/
*.log

# Dossier de déploiement ("prod") : certificats, clés privées et sauvegardes
# ne doivent jamais être versionnés
certs/
backups/
*.pem
*.key
*.crt

# OpenTofu / Terraform : le state contient des secrets (mot de passe de la base) et vit
# dans $STAGING_DIR ; .terraform/ = providers téléchargés par `tofu init`.
# Le fichier .terraform.lock.hcl, lui, EST versionné.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
terraform.tfvars
